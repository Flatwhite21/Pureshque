# ==============================================================================
# Pureshque Environment Configuration (.env.example)
# ==============================================================================

# --- AI Studio / Gemini API ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Django Backend Settings ---
DJANGO_SECRET_KEY="django-insecure-change-this-in-production-random-hash-key"
DEBUG=True
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# --- PostgreSQL Database ---
DB_ENGINE="django.db.backends.postgresql"
DB_NAME="pureshque_db"
DB_USER="pureshque_user"
DB_PASSWORD="secure_password_123"
DB_HOST="localhost"
DB_PORT=5432

# --- Redis & Celery ---
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# --- Email SMTP Gateway ---
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER="support@pureshque.ru"
EMAIL_HOST_PASSWORD="secure_smtp_password"
DEFAULT_FROM_EMAIL="Pureshque <no-reply@pureshque.ru>"

# --- OAuth 2.0 Credentials ---
VK_CLIENT_ID="51839201"
VK_CLIENT_SECRET="vk_secret_key_here"
VK_REDIRECT_URI="http://localhost:3000/auth/vk/callback"

YANDEX_CLIENT_ID="yandex_app_id_here"
YANDEX_CLIENT_SECRET="yandex_secret_key_here"
YANDEX_REDIRECT_URI="http://localhost:3000/auth/yandex/callback"

# --- Yandex.Disk Backup Storage ---
YANDEX_DISK_OAUTH_TOKEN="y0_AgAAAAAA_example_yandex_disk_token"
YANDEX_DISK_BACKUP_FOLDER="/Backups/Pureshque/"

# --- External Food APIs (Optional) ---
OPEN_FOOD_FACTS_ENABLED=True
OPEN_FOOD_FACTS_USER_AGENT="Pureshque/1.0 (contact@pureshque.ru)"
