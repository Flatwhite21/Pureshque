# ==========================================
# Pureshque Environment Variables (.env)
# ==========================================

# Django Configuration
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-pureshque-dev-secret-key-2026
ALLOWED_HOSTS=*

# PostgreSQL Database
POSTGRES_DB=pureshque_db
POSTGRES_USER=pureshque_user
POSTGRES_PASSWORD=pureshque_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# OAuth 2.0 Credentials
VK_CLIENT_ID=51000000
VK_CLIENT_SECRET=vk_mock_client_secret_key
YANDEX_CLIENT_ID=ya_client_id_pureshque
YANDEX_CLIENT_SECRET=ya_mock_client_secret_key

# External Integrations
YANDEX_DISK_TOKEN=y0_AgAAAAA_pureshque_sample_token_yandex_disk
OPENFOODFACTS_API_ENABLED=True

# SMTP Email
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=support@pureshque.ru
EMAIL_HOST_PASSWORD=smtp_app_password
EMAIL_USE_SSL=True

# Application URLs
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
